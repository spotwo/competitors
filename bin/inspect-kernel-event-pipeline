#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from event_pipeline_telemetry import (  # noqa: E402
    EventPipelineHealthCollector,
    render_prometheus,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Inspect the WMS event pipeline as one read-only health snapshot"
    )
    parser.add_argument(
        "--database-url",
        default=os.getenv("KERNEL_LAB_DATABASE_URL"),
        help="PostgreSQL URL (or KERNEL_LAB_DATABASE_URL)",
    )
    parser.add_argument(
        "--server-url",
        default=os.getenv("KERNEL_LAB_NATS_URL"),
        help="NATS server URL (or KERNEL_LAB_NATS_URL)",
    )
    parser.add_argument("--stream", required=True, help="JetStream stream name")
    parser.add_argument("--durable", required=True, help="JetStream durable consumer name")
    parser.add_argument(
        "--consumer-name",
        required=True,
        help="logical PostgreSQL Inbox/projection consumer identity",
    )
    parser.add_argument(
        "--malformed-lookback-seconds",
        type=int,
        default=300,
        help="recent malformed-delivery activity window (default: 300)",
    )
    parser.add_argument(
        "--projection-gap-monitor",
        choices=("inventory_position", "none"),
        default="inventory_position",
        help="projection gap buffer to inspect; none for strict Work State projection",
    )
    parser.add_argument(
        "--format",
        choices=("json", "prometheus"),
        default="json",
        help="output format",
    )
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument(
        "--check",
        action="store_true",
        help="exit 1 for warning and 2 for critical pipeline health",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.database_url:
        raise SystemExit("--database-url or KERNEL_LAB_DATABASE_URL is required")
    if not args.server_url:
        raise SystemExit("--server-url or KERNEL_LAB_NATS_URL is required")
    if args.pretty and args.format != "json":
        raise SystemExit("--pretty is available only with --format json")

    try:
        report = EventPipelineHealthCollector(
            args.database_url,
            args.server_url,
        ).collect(
            stream_name=args.stream,
            durable_name=args.durable,
            consumer_name=args.consumer_name,
            malformed_lookback_seconds=args.malformed_lookback_seconds,
            projection_gap_monitor=args.projection_gap_monitor,
        )
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc

    if args.format == "prometheus":
        sys.stdout.write(render_prometheus(report))
    else:
        print(
            json.dumps(
                report.to_dict(),
                indent=2 if args.pretty else None,
                sort_keys=True,
                separators=None if args.pretty else (",", ":"),
            )
        )

    if not args.check:
        return 0
    return {"ok": 0, "warning": 1, "critical": 2}[report.status]


if __name__ == "__main__":
    raise SystemExit(main())
