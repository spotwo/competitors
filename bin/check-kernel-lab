#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB="$ROOT/labs/postgres-inventory-kernel"
COMPOSE=(docker compose -f "$LAB/compose.yaml")
PORT="${KERNEL_LAB_PORT:-55432}"
export KERNEL_LAB_PORT="$PORT"
export KERNEL_LAB_DATABASE_URL="${KERNEL_LAB_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:${PORT}/kernel_lab}"

cleanup() {
  "${COMPOSE[@]}" down -v --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

command -v docker >/dev/null || { echo "docker is required" >&2; exit 2; }
docker compose version >/dev/null

python -m pip install -r "$LAB/requirements.txt"

cleanup
"${COMPOSE[@]}" up -d --wait
"${COMPOSE[@]}" exec -T db \
  psql -U postgres -d kernel_lab -v ON_ERROR_STOP=1 \
  < "$LAB/sql/001_schema.sql"

python -m pytest -q "$LAB/tests"
