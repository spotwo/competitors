#!/usr/bin/env python3
"""Manage ONLY reviewed opt-in per-tenant JetStream durables, never shared ones."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs/postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from event_pipeline_readiness import load_registry  # noqa: E402
from tenant_event_deployment import (  # noqa: E402
    TenantReadinessGate,
    TenantTopologyProvisioner,
    load_tenant_deployments,
)
from tenant_deployment_probe import TenantDeploymentProbe  # noqa: E402
from tenant_deployment_activation import TenantActivationController  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Opt-in tenant event pipeline deployment")
    parser.add_argument("--registry", type=Path, default=ROOT / "operations/event-pipelines/registry.yml")
    parser.add_argument("--deployment", required=True, help="Reviewed tenant deployment id")
    parser.add_argument("--mode", choices=("plan", "apply", "readiness", "activate"), default="plan")
    parser.add_argument("--operator-id")
    parser.add_argument("--approval-id")
    args = parser.parse_args()

    with args.registry.open("r", encoding="utf-8") as fh:
        raw = yaml.safe_load(fh)
    registry = load_registry(args.registry)
    deployments = load_tenant_deployments(raw, registry)
    matching = [item for item in deployments if item.deployment.deployment_id == args.deployment]
    if len(matching) != 1:
        parser.error("unknown or duplicate tenant deployment")
    binding = matching[0]

    def env(name: str) -> str:
        value = os.getenv(name)
        if not value:
            parser.error(f"required credential environment variable is missing: {name}")
        return value

    admin_url = env(binding.deployment.provisioner_nats_url_env)
    provisioner = TenantTopologyProvisioner(admin_url)
    if args.mode == "plan":
        print(json.dumps(provisioner.plan(binding).to_dict(), sort_keys=True))
        return 0
    if args.mode == "apply":
        if not args.operator_id or not args.approval_id:
            parser.error("--apply requires --operator-id and --approval-id")
        plan = provisioner.provision(
            binding, operator_id=args.operator_id, approval_id=args.approval_id,
        )
        print(json.dumps(plan.to_dict(), sort_keys=True))
        return 0

    if args.mode == "activate":
        if not args.operator_id or not args.approval_id:
            parser.error("activation requires --operator-id and --approval-id")
        if not binding.deployment.enabled:
            parser.error("tenant deployment is disabled; activation is forbidden")
        receipt = TenantActivationController(
            database_url=env(binding.parent.runtime.database_url_env),
            provisioner_nats_url=admin_url,
            publisher_nats_url=env(binding.deployment.publisher_nats_url_env),
            consumer_nats_url=env(binding.deployment.consumer_nats_url_env),
            canary_consumer_nats_url=env(
                binding.deployment.canary_consumer_nats_url_env
            ),
        ).activate(
            binding, operator_id=args.operator_id, approval_id=args.approval_id,
        )
        print(json.dumps(receipt.to_dict(), sort_keys=True))
        return 0

    topology = provisioner.plan(binding)
    acl_proof = None
    canary_proof = None
    if binding.deployment.enabled and topology.status == "ready":
        acl_proof, canary_proof = TenantDeploymentProbe(
            publisher_nats_url=env(binding.deployment.publisher_nats_url_env),
            consumer_nats_url=env(binding.deployment.consumer_nats_url_env),
            canary_consumer_nats_url=env(
                binding.deployment.canary_consumer_nats_url_env
            ),
        ).run(binding)
    report = TenantReadinessGate().assess(
        binding, topology=topology, acl_proof=acl_proof,
        canary_proof=canary_proof,
    )
    print(json.dumps(report.to_dict(), sort_keys=True))
    return 0 if report.status == "ready" else 2


if __name__ == "__main__":
    raise SystemExit(main())
