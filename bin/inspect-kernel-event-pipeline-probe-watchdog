#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from event_pipeline_probe_watchdog import (  # noqa: E402
    ExternalProbeWatchdogPolicy,
    ExternalProbeWatchdogSnapshot,
    render_prometheus,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Evaluate external scheduler health for the event pipeline canary"
    )
    parser.add_argument(
        "--state-file",
        required=True,
        help="JSON state owned by the external scheduler/watchdog",
    )
    parser.add_argument(
        "--observed-at",
        help="override observation time with an ISO-8601 timestamp",
    )
    parser.add_argument("--start-grace-seconds", type=float, default=30.0)
    parser.add_argument("--warning-missing-executions", type=int, default=1)
    parser.add_argument("--critical-missing-executions", type=int, default=2)
    parser.add_argument("--warning-scheduler-lag-seconds", type=float, default=15.0)
    parser.add_argument("--critical-scheduler-lag-seconds", type=float, default=60.0)
    parser.add_argument("--execution-timeout-seconds", type=float, default=45.0)
    parser.add_argument("--format", choices=("json", "prometheus"), default="json")
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument(
        "--check",
        action="store_true",
        help="exit 1 for warning and 2 for critical watchdog health",
    )
    return parser.parse_args()


def _parse_observed_at(value: str | None) -> datetime | None:
    if value is None:
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError("--observed-at must be an ISO-8601 timestamp") from exc
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ValueError("--observed-at must include a timezone")
    return parsed


def main() -> int:
    args = parse_args()
    if args.pretty and args.format != "json":
        raise SystemExit("--pretty is available only with --format json")

    try:
        payload = json.loads(Path(args.state_file).read_text(encoding="utf-8"))
        snapshot = ExternalProbeWatchdogSnapshot.from_dict(
            payload,
            observed_at=_parse_observed_at(args.observed_at),
        )
        report = ExternalProbeWatchdogPolicy(
            start_grace_seconds=args.start_grace_seconds,
            warning_missing_executions=args.warning_missing_executions,
            critical_missing_executions=args.critical_missing_executions,
            warning_scheduler_lag_seconds=args.warning_scheduler_lag_seconds,
            critical_scheduler_lag_seconds=args.critical_scheduler_lag_seconds,
            execution_timeout_seconds=args.execution_timeout_seconds,
        ).evaluate(snapshot)
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"event pipeline probe watchdog failed: {exc}", file=sys.stderr)
        return 2

    if args.format == "prometheus":
        sys.stdout.write(render_prometheus(report))
    else:
        print(
            json.dumps(
                report.to_dict(),
                indent=2 if args.pretty else None,
                sort_keys=True,
                separators=None if args.pretty else (",", ":"),
            )
        )

    if not args.check:
        return 0
    return {"ok": 0, "warning": 1, "critical": 2}[report.status]


if __name__ == "__main__":
    raise SystemExit(main())
