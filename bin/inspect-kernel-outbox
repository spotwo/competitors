#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from outbox_telemetry import (  # noqa: E402
    OutboxAlertPolicy,
    PostgresOutboxTelemetryStore,
    render_prometheus,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Inspect WMS kernel Outbox telemetry and health"
    )
    parser.add_argument(
        "--database-url",
        default=os.getenv("KERNEL_LAB_DATABASE_URL"),
        help="PostgreSQL URL (or KERNEL_LAB_DATABASE_URL)",
    )
    parser.add_argument("--format", choices=("json", "prometheus"), default="json")
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument("--check", action="store_true", help="exit 1 on warning, 2 on critical")
    parser.add_argument("--warning-ready-age-seconds", type=int, default=60)
    parser.add_argument("--critical-ready-age-seconds", type=int, default=300)
    parser.add_argument("--warning-backlog-count", type=int, default=1000)
    parser.add_argument("--critical-backlog-count", type=int, default=10000)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.database_url:
        raise SystemExit("--database-url or KERNEL_LAB_DATABASE_URL is required")
    if args.pretty and args.format != "json":
        raise SystemExit("--pretty is available only with --format json")

    try:
        policy = OutboxAlertPolicy(
            warning_ready_age_seconds=args.warning_ready_age_seconds,
            critical_ready_age_seconds=args.critical_ready_age_seconds,
            warning_backlog_count=args.warning_backlog_count,
            critical_backlog_count=args.critical_backlog_count,
        )
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc

    snapshot = PostgresOutboxTelemetryStore(args.database_url).snapshot()
    report = policy.evaluate(snapshot)

    if args.format == "prometheus":
        sys.stdout.write(render_prometheus(report))
    else:
        print(
            json.dumps(
                report.to_dict(),
                indent=2 if args.pretty else None,
                sort_keys=True,
                separators=None if args.pretty else (",", ":"),
            )
        )

    if not args.check:
        return 0
    return {"ok": 0, "warning": 1, "critical": 2}[report.status]


if __name__ == "__main__":
    raise SystemExit(main())
