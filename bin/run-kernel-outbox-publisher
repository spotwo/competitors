#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from publisher_runtime import (  # noqa: E402
    ClaimedEvent,
    PostgresOutboxStore,
    PostgresTenantOutboxStore,
    PublishReceipt,
    PublisherRuntime,
    RetryPolicy,
)
from nats_transport import NatsJetStreamTransport  # noqa: E402
from event_tenant_routing import TenantEventRoute, tenant_uuid  # noqa: E402


class JsonLineStdoutTransport:
    """Development adapter: one canonical event envelope per stdout line."""

    def publish(self, event: ClaimedEvent) -> PublishReceipt:
        print(json.dumps(event.envelope, sort_keys=True, separators=(",", ":")), flush=True)
        return PublishReceipt(transport_message_id=str(event.event_id))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run the WMS kernel outbox publisher")
    parser.add_argument(
        "--database-url",
        default=os.getenv("KERNEL_LAB_DATABASE_URL"),
        help="PostgreSQL URL (or KERNEL_LAB_DATABASE_URL)",
    )
    parser.add_argument(
        "--worker-id",
        default=f"{socket.gethostname()}:{os.getpid()}",
        help="stable identity for this publisher process",
    )
    parser.add_argument("--batch-size", type=int, default=100)
    parser.add_argument("--lease-seconds", type=int, default=30)
    parser.add_argument("--retry-base-seconds", type=int, default=5)
    parser.add_argument("--retry-max-seconds", type=int, default=300)
    parser.add_argument("--retry-jitter-ratio", type=float, default=0.2)
    parser.add_argument("--max-attempts", type=int, default=10)
    parser.add_argument("--idle-sleep-seconds", type=float, default=1.0)
    parser.add_argument("--once", action="store_true", help="process at most one claim batch")
    parser.add_argument(
        "--transport",
        choices=("stdout", "nats"),
        default=os.getenv("KERNEL_LAB_TRANSPORT", "stdout"),
    )
    parser.add_argument("--nats-url", default=os.getenv("KERNEL_LAB_NATS_URL"))
    parser.add_argument("--nats-stream", default=os.getenv("KERNEL_LAB_NATS_STREAM", "WMS_EVENTS"))
    parser.add_argument(
        "--tenant-id",
        help="opt-in canonical UUID for fenced V2 tenant-staged claims (NATS only)",
    )
    parser.add_argument(
        "--nats-subject-prefix",
        default=os.getenv("KERNEL_LAB_NATS_SUBJECT_PREFIX", "spotwo.wms.events"),
    )
    return parser.parse_args()


def build_transport(args: argparse.Namespace):
    if args.transport == "stdout":
        return JsonLineStdoutTransport()
    if not args.nats_url:
        raise SystemExit("--nats-url or KERNEL_LAB_NATS_URL is required for --transport nats")
    route = (
        TenantEventRoute(args.nats_subject_prefix, tenant_uuid(args.tenant_id))
        if args.tenant_id else None
    )
    return NatsJetStreamTransport(
        server_url=args.nats_url,
        stream_name=args.nats_stream,
        subject_prefix=args.nats_subject_prefix,
        client_name=args.worker_id,
        tenant_route=route,
    )


def main() -> int:
    args = parse_args()
    if not args.database_url:
        raise SystemExit("--database-url or KERNEL_LAB_DATABASE_URL is required")
    if args.idle_sleep_seconds < 0:
        raise SystemExit("--idle-sleep-seconds must be nonnegative")
    if args.tenant_id and args.transport != "nats":
        raise SystemExit("--tenant-id requires --transport nats")
    try:
        scoped_tenant = tenant_uuid(args.tenant_id) if args.tenant_id else None
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc

    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    transport = build_transport(args)
    publisher = PublisherRuntime(
        store=(
            PostgresTenantOutboxStore(args.database_url, tenant_id=scoped_tenant)
            if scoped_tenant is not None else PostgresOutboxStore(args.database_url)
        ),
        transport=transport,
        worker_id=args.worker_id,
        batch_size=args.batch_size,
        lease_seconds=args.lease_seconds,
        retry_policy=RetryPolicy(
            base_delay_seconds=args.retry_base_seconds,
            max_delay_seconds=args.retry_max_seconds,
            jitter_ratio=args.retry_jitter_ratio,
            max_attempts=args.max_attempts,
        ),
    )

    try:
        while not stopping:
            result = publisher.run_once()
            print(
                json.dumps(
                    {
                        "publisher_cycle": {
                            "worker_id": args.worker_id,
                            "claimed": result.claimed,
                            "published": result.published,
                            "failed": result.failed,
                            "quarantined": result.quarantined,
                            "stale_ack": result.stale_ack,
                            "stale_nack": result.stale_nack,
                            "stale_quarantine": result.stale_quarantine,
                        }
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                ),
                file=sys.stderr,
                flush=True,
            )

            if args.once:
                break
            if result.claimed == 0 and args.idle_sleep_seconds:
                time.sleep(args.idle_sleep_seconds)
    finally:
        close = getattr(transport, "close", None)
        if close is not None:
            close()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
