#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from publisher_runtime import (  # noqa: E402
    ClaimedEvent,
    PostgresOutboxStore,
    PublishReceipt,
    PublisherRuntime,
)


class JsonLineStdoutTransport:
    """Development adapter: one canonical event envelope per stdout line."""

    def publish(self, event: ClaimedEvent) -> PublishReceipt:
        print(json.dumps(event.envelope, sort_keys=True, separators=(",", ":")), flush=True)
        return PublishReceipt(transport_message_id=str(event.event_id))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run the WMS kernel outbox publisher")
    parser.add_argument(
        "--database-url",
        default=os.getenv("KERNEL_LAB_DATABASE_URL"),
        help="PostgreSQL URL (or KERNEL_LAB_DATABASE_URL)",
    )
    parser.add_argument(
        "--worker-id",
        default=f"{socket.gethostname()}:{os.getpid()}",
        help="stable identity for this publisher process",
    )
    parser.add_argument("--batch-size", type=int, default=100)
    parser.add_argument("--lease-seconds", type=int, default=30)
    parser.add_argument("--retry-after-seconds", type=int, default=5)
    parser.add_argument("--idle-sleep-seconds", type=float, default=1.0)
    parser.add_argument("--once", action="store_true", help="process at most one claim batch")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.database_url:
        raise SystemExit("--database-url or KERNEL_LAB_DATABASE_URL is required")
    if args.idle_sleep_seconds < 0:
        raise SystemExit("--idle-sleep-seconds must be nonnegative")

    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    publisher = PublisherRuntime(
        store=PostgresOutboxStore(args.database_url),
        transport=JsonLineStdoutTransport(),
        worker_id=args.worker_id,
        batch_size=args.batch_size,
        lease_seconds=args.lease_seconds,
        retry_after_seconds=args.retry_after_seconds,
    )

    while not stopping:
        result = publisher.run_once()
        print(
            json.dumps(
                {
                    "publisher_cycle": {
                        "worker_id": args.worker_id,
                        "claimed": result.claimed,
                        "published": result.published,
                        "failed": result.failed,
                        "stale_ack": result.stale_ack,
                        "stale_nack": result.stale_nack,
                    }
                },
                sort_keys=True,
                separators=(",", ":"),
            ),
            file=sys.stderr,
            flush=True,
        )

        if args.once:
            break
        if result.claimed == 0 and args.idle_sleep_seconds:
            time.sleep(args.idle_sleep_seconds)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
