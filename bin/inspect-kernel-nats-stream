#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from nats_stream_telemetry import (  # noqa: E402
    DEFAULT_CRITICAL_CAPACITY_RATIO,
    DEFAULT_CRITICAL_REPLICA_LAG_MESSAGES,
    DEFAULT_WARNING_CAPACITY_RATIO,
    DEFAULT_WARNING_REPLICA_LAG_MESSAGES,
    NatsJetStreamStreamTelemetryStore,
    NatsStreamAlertPolicy,
    render_prometheus,
)


def percent(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("percentage must be numeric") from exc
    if not 0 < parsed <= 100:
        raise argparse.ArgumentTypeError("percentage must be within (0, 100]")
    return parsed / 100.0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Inspect one existing NATS JetStream stream")
    parser.add_argument(
        "--server-url",
        default=os.getenv("KERNEL_LAB_NATS_URL"),
        help="NATS server URL (or KERNEL_LAB_NATS_URL)",
    )
    parser.add_argument("--stream", required=True, help="JetStream stream name")
    parser.add_argument("--format", choices=("json", "prometheus"), default="json")
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument(
        "--check",
        action="store_true",
        help="exit 1 for warning and 2 for critical health",
    )
    parser.add_argument(
        "--warning-capacity-percent",
        type=percent,
        default=DEFAULT_WARNING_CAPACITY_RATIO,
        help="warning threshold for finite message/byte capacity (default: 80)",
    )
    parser.add_argument(
        "--critical-capacity-percent",
        type=percent,
        default=DEFAULT_CRITICAL_CAPACITY_RATIO,
        help="critical threshold for finite message/byte capacity (default: 95)",
    )
    parser.add_argument(
        "--warning-replica-lag",
        type=int,
        default=DEFAULT_WARNING_REPLICA_LAG_MESSAGES,
        help="warning threshold for maximum follower lag in messages",
    )
    parser.add_argument(
        "--critical-replica-lag",
        type=int,
        default=DEFAULT_CRITICAL_REPLICA_LAG_MESSAGES,
        help="critical threshold for maximum follower lag in messages",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.server_url:
        raise SystemExit("--server-url or KERNEL_LAB_NATS_URL is required")

    try:
        policy = NatsStreamAlertPolicy(
            warning_capacity_ratio=args.warning_capacity_percent,
            critical_capacity_ratio=args.critical_capacity_percent,
            warning_replica_lag_messages=args.warning_replica_lag,
            critical_replica_lag_messages=args.critical_replica_lag,
        )
        snapshot = NatsJetStreamStreamTelemetryStore(args.server_url).snapshot(
            stream_name=args.stream,
        )
        report = policy.evaluate(snapshot)
    except Exception as exc:
        print(f"NATS stream health inspection failed: {exc}", file=sys.stderr)
        return 2

    if args.format == "prometheus":
        sys.stdout.write(render_prometheus(report))
    else:
        print(
            json.dumps(
                report.to_dict(),
                indent=2 if args.pretty else None,
                sort_keys=True,
                separators=None if args.pretty else (",", ":"),
            )
        )

    if not args.check:
        return 0
    return {"ok": 0, "warning": 1, "critical": 2}[report.status]


if __name__ == "__main__":
    raise SystemExit(main())
