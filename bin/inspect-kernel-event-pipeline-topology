#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
sys.path.insert(0, str(LAB))

from event_pipeline_readiness import load_registry  # noqa: E402
from event_pipeline_topology import (  # noqa: E402
    NatsJetStreamTopologyInspector,
    render_prometheus,
)
from event_pipeline_topology_config import (  # noqa: E402
    DeploymentTopologyConfig,
    pipeline_topology_mapping,
)

DEFAULT_REGISTRY = ROOT / "operations" / "event-pipelines" / "registry.yml"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Compare deployed JetStream topology with the canonical event pipeline registry"
    )
    parser.add_argument("--registry", default=str(DEFAULT_REGISTRY))
    parser.add_argument("--pipeline", required=True)
    parser.add_argument(
        "--nats-url",
        help="lab override for NATS URL; otherwise use the registry-named env var",
    )
    parser.add_argument("--format", choices=("json", "prometheus"), default="json")
    parser.add_argument("--pretty", action="store_true", help="indent JSON output")
    parser.add_argument(
        "--check",
        action="store_true",
        help="exit 2 when deployed topology does not match the registry",
    )
    return parser.parse_args()


def _read_registry_mapping(path: str) -> dict:
    with Path(path).open("r", encoding="utf-8") as handle:
        value = yaml.safe_load(handle)
    if not isinstance(value, dict):
        raise ValueError("registry root must be an object")
    return value


def main() -> int:
    args = parse_args()
    if args.pretty and args.format != "json":
        raise SystemExit("--pretty is available only with --format json")

    try:
        registry = load_registry(args.registry)
        registry_data = _read_registry_mapping(args.registry)
        spec = registry.get(args.pipeline)
        topology = pipeline_topology_mapping(registry_data, args.pipeline)
        expectation = DeploymentTopologyConfig.from_mapping(topology).expectation(spec)
    except KeyError as exc:
        raise SystemExit(f"unknown event pipeline deployment: {args.pipeline}") from exc
    except (OSError, ValueError) as exc:
        raise SystemExit(f"event pipeline deployment registry invalid: {exc}") from exc

    nats_url = args.nats_url or os.getenv(spec.runtime.nats_url_env)
    if not nats_url:
        raise SystemExit(
            f"--nats-url or registry-named environment variable {spec.runtime.nats_url_env} is required"
        )

    try:
        report = NatsJetStreamTopologyInspector(nats_url).inspect(expectation)
    except Exception as exc:
        raise SystemExit(
            f"JetStream topology inspection unavailable: {type(exc).__name__}"
        ) from exc

    if args.format == "prometheus":
        sys.stdout.write(render_prometheus(report, pipeline_id=spec.pipeline_id))
    else:
        print(
            json.dumps(
                report.to_dict(),
                indent=2 if args.pretty else None,
                sort_keys=True,
                separators=None if args.pretty else (",", ":"),
            )
        )

    if not args.check:
        return 0
    return 0 if report.status == "ok" else 2


if __name__ == "__main__":
    raise SystemExit(main())
