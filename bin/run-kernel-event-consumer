#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LAB = ROOT / "labs" / "postgres-inventory-kernel"
DEFAULT_REGISTRY = ROOT / "operations" / "event-pipelines" / "registry.yml"
sys.path.insert(0, str(LAB))

from consumer_failure import (  # noqa: E402
    DurableConsumerFailureLane,
    PostgresConsumerFailureStore,
)
from consumer_runtime import InboxConsumerRuntime, PostgresInboxStore  # noqa: E402
from event_pipeline_readiness import load_registry  # noqa: E402
from malformed_delivery import PostgresNatsMalformedDeliveryQuarantine  # noqa: E402
from nats_consumer import NatsJetStreamPullSource  # noqa: E402
from position_projection import InventoryPositionQuantityProjector  # noqa: E402
from work_state_projection import WarehouseWorkStateProjector  # noqa: E402


HANDLERS = {
    "inventory-position-projection": InventoryPositionQuantityProjector,
    "warehouse-work-state-projection": WarehouseWorkStateProjector,
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run a registry-backed WMS business event consumer"
    )
    parser.add_argument("--pipeline", required=True, help="deployment registry pipeline id")
    parser.add_argument(
        "--registry",
        type=Path,
        default=DEFAULT_REGISTRY,
        help="event pipeline deployment registry",
    )
    parser.add_argument("--database-url", help="override configured PostgreSQL URL env")
    parser.add_argument("--nats-url", help="override configured NATS URL env")
    parser.add_argument(
        "--allow-disabled",
        action="store_true",
        help="allow a disabled pipeline for bounded lab proof only",
    )
    parser.add_argument(
        "--client-name",
        help="NATS client name; defaults to pipeline, host, and process identity",
    )
    parser.add_argument("--fetch-timeout-seconds", type=float, default=1.0)
    parser.add_argument("--idle-sleep-seconds", type=float, default=0.25)
    parser.add_argument("--once", action="store_true", help="run one fetch cycle")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    registry = load_registry(args.registry)
    try:
        spec = registry.get(args.pipeline)
    except KeyError as exc:
        raise SystemExit(f"unknown event pipeline: {args.pipeline}") from exc

    if not spec.enabled and not args.allow_disabled:
        raise SystemExit(
            f"event pipeline {spec.pipeline_id} is disabled; use --allow-disabled only for a bounded lab proof"
        )

    handler_type = HANDLERS.get(spec.pipeline_id)
    if handler_type is None:
        raise SystemExit(f"no business handler registered for pipeline {spec.pipeline_id}")

    database_url = args.database_url or os.getenv(spec.runtime.database_url_env)
    nats_url = args.nats_url or os.getenv(spec.runtime.nats_url_env)
    if not database_url:
        raise SystemExit(
            f"--database-url or {spec.runtime.database_url_env} is required"
        )
    if not nats_url:
        raise SystemExit(f"--nats-url or {spec.runtime.nats_url_env} is required")
    if args.fetch_timeout_seconds <= 0:
        raise SystemExit("--fetch-timeout-seconds must be positive")
    if args.idle_sleep_seconds < 0:
        raise SystemExit("--idle-sleep-seconds must be nonnegative")

    client_name = args.client_name or (
        f"{spec.pipeline_id}:{socket.gethostname()}:{os.getpid()}"
    )
    handler = handler_type(consumer_name=spec.consumer.inbox_consumer_name)
    failure_lane = DurableConsumerFailureLane(
        store=PostgresConsumerFailureStore(database_url)
    )
    malformed_lane = PostgresNatsMalformedDeliveryQuarantine(database_url)

    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    with NatsJetStreamPullSource(
        server_url=nats_url,
        stream_name=spec.transport.stream,
        durable_name=spec.consumer.durable,
        client_name=client_name,
        fetch_timeout_seconds=args.fetch_timeout_seconds,
    ) as source:
        runtime = InboxConsumerRuntime(
            source=source,
            store=PostgresInboxStore(database_url),
            consumer_name=spec.consumer.inbox_consumer_name,
            handler=handler,
            failure_lane=failure_lane,
            malformed_lane=malformed_lane,
        )

        while not stopping:
            result = runtime.run_once()
            print(
                json.dumps(
                    {
                        "business_consumer_cycle": {
                            "pipeline": spec.pipeline_id,
                            "received": result.received,
                            "applied": result.applied,
                            "duplicate": result.duplicate,
                            "deferred": result.deferred,
                            "quarantined": result.quarantined,
                            "malformed": result.malformed,
                            "acknowledged": result.acknowledged,
                            "event_id": str(result.event_id) if result.event_id else None,
                            "transport_message_id": result.transport_message_id,
                            "delivery_count": result.delivery_count,
                            "failure_code": result.failure_code,
                        }
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                ),
                file=sys.stderr,
                flush=True,
            )
            if args.once:
                break
            if result.received == 0 and args.idle_sleep_seconds:
                time.sleep(args.idle_sleep_seconds)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
