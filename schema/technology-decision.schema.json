{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schema/technology-decision.schema.json",
  "title": "Spotwo technology decision registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "policy", "decisions"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date"},
    "policy": {"$ref": "#/$defs/policy"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "dispositions", "evidence_rules"],
      "properties": {
        "purpose": {"type": "string", "minLength": 20},
        "dispositions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adopt", "trial", "watch", "reject"],
          "properties": {
            "adopt": {"type": "string", "minLength": 10},
            "trial": {"type": "string", "minLength": 10},
            "watch": {"type": "string", "minLength": 10},
            "reject": {"type": "string", "minLength": 10}
          }
        },
        "evidence_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "market_usage_is_signal_not_authority",
            "open_source_popularity_is_signal_not_authority",
            "accepted_repository_decisions_take_precedence",
            "unknown_beats_guess",
            "every_decision_is_scoped"
          ],
          "properties": {
            "market_usage_is_signal_not_authority": {"const": true},
            "open_source_popularity_is_signal_not_authority": {"const": true},
            "accepted_repository_decisions_take_precedence": {"const": true},
            "unknown_beats_guess": {"const": true},
            "every_decision_is_scoped": {"const": true}
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "scope",
        "disposition",
        "confidence",
        "rationale",
        "evidence",
        "constraints",
        "alternatives",
        "next_action",
        "revisit_triggers"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "category": {
          "type": "string",
          "enum": [
            "api-contract",
            "database",
            "deployment-orchestration",
            "event-transport",
            "geospatial",
            "industrial-connectivity",
            "industrial-telemetry",
            "logistics-standard",
            "optimization",
            "robotics",
            "simulation",
            "warehouse-reference"
          ]
        },
        "scope": {"type": "string", "minLength": 20},
        "disposition": {"type": "string", "enum": ["adopt", "trial", "watch", "reject"]},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "rationale": {"type": "string", "minLength": 40},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_refs", "open_source_project_refs", "competitor_product_refs"],
          "properties": {
            "repository_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "open_source_project_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
            },
            "competitor_product_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"}
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "description"],
          "properties": {
            "type": {"type": "string", "enum": ["continue", "prototype", "benchmark", "research", "none"]},
            "description": {"type": "string", "minLength": 20}
          }
        },
        "revisit_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
