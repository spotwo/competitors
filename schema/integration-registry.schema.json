{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schemas/integration-registry.schema.json",
  "title": "Integration Pattern Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "patterns", "last_verified", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "directionality", "status", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "category": {"enum": ["master-data", "transaction", "event", "device", "identity", "labeling", "telemetry", "batch"]},
          "directionality": {"enum": ["inbound", "outbound", "bidirectional"]},
          "status": {"enum": ["adopted", "candidate", "internal-proposal", "observed", "needs-research"]},
          "description": {"type": "string"},
          "typical_protocols": {"type": "array", "items": {"type": "string"}},
          "entities": {"type": "array", "items": {"type": "string"}},
          "reliability_controls": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "research_gaps": {"type": "array", "items": {"type": "string"}},
    "last_verified": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
