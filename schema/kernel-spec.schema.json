{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schema/kernel-spec.schema.json",
  "title": "Spotwo WMS Kernel Reference Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "frozen_on",
    "purpose",
    "production_ready",
    "stable_contracts",
    "stable_boundaries",
    "executable_contract",
    "required_golden_scenarios",
    "benchmark_evidence",
    "v0_2_candidates"
  ],
  "properties": {
    "id": {"const": "spotwo-wms-kernel"},
    "version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
    "status": {"const": "frozen-reference"},
    "frozen_on": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 20},
    "production_ready": {"const": false},
    "stable_contracts": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adr"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "adr": {"type": "string", "pattern": "^decisions/domain/[0-9]{4}-.+\\.md$"}
        }
      }
    },
    "stable_boundaries": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "executable_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres_lab", "migrations", "minimum_functional_tests", "validation_commands"],
      "properties": {
        "postgres_lab": {"type": "string", "minLength": 1},
        "migrations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^labs/postgres-inventory-kernel/sql/[0-9]{3}_.+\\.sql$"}
        },
        "minimum_functional_tests": {"type": "integer", "minimum": 1},
        "validation_commands": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_golden_scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "ids"],
      "properties": {
        "registry": {"type": "string", "pattern": "^scenarios/.+\\.yml$"},
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    },
    "benchmark_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodology", "baselines", "latency_is_slo"],
      "properties": {
        "methodology": {"type": "string", "pattern": "^decisions/domain/[0-9]{4}-.+\\.md$"},
        "baselines": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^labs/postgres-inventory-kernel/benchmarks/baselines/.+\\.json$"}
        },
        "latency_is_slo": {"const": false}
      }
    },
    "v0_2_candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    }
  }
}
