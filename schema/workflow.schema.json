{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schemas/workflow.schema.json",
  "title": "Capability Workflow Decomposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "capability_id", "title", "status", "definition", "stages", "objects", "states", "strategies", "vendor_models", "spotwo", "last_verified", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "capability_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]},
    "definition": {"type": "string", "minLength": 1},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "purpose"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "purpose": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "term", "role"], "properties": {"id": {"type": "string"}, "term": {"type": "string"}, "role": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "notes": {"type": "string"}}}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "meaning"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "meaning": {"type": "string"}, "terminal": {"type": "boolean"}}}},
    "strategies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "category", "label", "definition", "evidence_refs"], "properties": {"id": {"type": "string"}, "category": {"enum": ["trigger", "policy", "quantity", "source-selection", "destination-selection", "release", "grouping", "assignment", "routing", "execution", "confirmation", "consolidation"]}, "label": {"type": "string"}, "definition": {"type": "string"}, "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "exceptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "trigger", "outcomes", "evidence_refs"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "trigger": {"type": "string"}, "outcomes": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "vendor_models": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["company_id", "workflow", "evidence_refs"], "properties": {"company_id": {"type": "string"}, "product_id": {"type": "string"}, "terminology": {"type": "object", "additionalProperties": {"type": "string"}}, "workflow": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "strategies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "execution_channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "notes": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}}},
    "spotwo": {"type": "object", "additionalProperties": false, "required": ["status", "canonical_spine", "canonical_objects", "task_states"], "properties": {"status": {"enum": ["adopted", "candidate", "observed", "needs-research"]}, "canonical_spine": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "canonical_objects": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "task_states": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "notes": {"type": "string"}}},
    "research_gaps": {"type": "array", "items": {"type": "string"}},
    "last_verified": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}
