{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schemas/kpi-registry.schema.json",
  "title": "Warehouse KPI Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "metrics", "last_verified", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "direction", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "category": {"enum": ["customer", "inbound", "outbound", "financial", "capacity-quality", "employee", "perfect-order", "cash-to-cash"]},
          "direction": {"enum": ["higher-is-better", "lower-is-better", "context-dependent"]},
          "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]},
          "unit": {"type": "string"},
          "formula": {"type": ["string", "null"]},
          "notes": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "research_gaps": {"type": "array", "items": {"type": "string"}},
    "last_verified": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
