{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.example/schema/event-pipeline-deployment.schema.json",
  "title": "Spotwo event pipeline deployment registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pipelines"],
  "properties": {
    "version": {"const": 1},
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pipeline"}
    },
    "tenant_deployments": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tenantDeployment"}
    }
  },
  "$defs": {
    "tenantDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "pipeline_id", "tenant_id", "enabled",
        "business_durable", "inbox_consumer_name", "canary_durable",
        "provisioner_nats_url_env", "publisher_nats_url_env",
        "consumer_nats_url_env", "canary_consumer_nats_url_env"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "pipeline_id": {"type": "string", "const": "inventory-transaction-index"},
        "tenant_id": {"type": "string", "format": "uuid"},
        "enabled": {"type": "boolean"},
        "business_durable": {"$ref": "#/$defs/name"},
        "inbox_consumer_name": {"$ref": "#/$defs/name"},
        "canary_durable": {"$ref": "#/$defs/name"},
        "provisioner_nats_url_env": {"$ref": "#/$defs/envName"},
        "publisher_nats_url_env": {"$ref": "#/$defs/envName"},
        "consumer_nats_url_env": {"$ref": "#/$defs/envName"},
        "canary_consumer_nats_url_env": {"$ref": "#/$defs/envName"}
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "consumerTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_mode",
        "deliver_policy",
        "ack_policy",
        "filter_subject",
        "max_ack_pending",
        "max_deliver"
      ],
      "properties": {
        "delivery_mode": {"enum": ["pull", "push"]},
        "deliver_policy": {
          "enum": [
            "all",
            "last",
            "new",
            "by_start_sequence",
            "by_start_time",
            "last_per_subject"
          ]
        },
        "ack_policy": {"enum": ["explicit", "all", "none"]},
        "filter_subject": {"$ref": "#/$defs/name"},
        "max_ack_pending": {"$ref": "#/$defs/positiveInteger"},
        "max_deliver": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "streamTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "storage",
        "retention",
        "replicas",
        "duplicate_window_seconds"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "storage": {"enum": ["file", "memory"]},
        "retention": {"enum": ["limits", "interest", "workqueue"]},
        "replicas": {"$ref": "#/$defs/positiveInteger"},
        "duplicate_window_seconds": {"$ref": "#/$defs/positiveNumber"}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "business_consumer", "canary_consumer"],
      "properties": {
        "stream": {"$ref": "#/$defs/streamTopology"},
        "business_consumer": {"$ref": "#/$defs/consumerTopology"},
        "canary_consumer": {"$ref": "#/$defs/consumerTopology"}
      }
    },
    "streamTopologyOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "storage": {"enum": ["file", "memory"]},
        "retention": {"enum": ["limits", "interest", "workqueue"]},
        "replicas": {"$ref": "#/$defs/positiveInteger"},
        "duplicate_window_seconds": {"$ref": "#/$defs/positiveNumber"}
      }
    },
    "consumerTopologyOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "delivery_mode": {"enum": ["pull", "push"]},
        "deliver_policy": {
          "enum": [
            "all",
            "last",
            "new",
            "by_start_sequence",
            "by_start_time",
            "last_per_subject"
          ]
        },
        "ack_policy": {"enum": ["explicit", "all", "none"]},
        "filter_subject": {"$ref": "#/$defs/name"},
        "max_ack_pending": {"$ref": "#/$defs/positiveInteger"},
        "max_deliver": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "topologyOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stream": {"$ref": "#/$defs/streamTopologyOverrides"},
        "business_consumer": {"$ref": "#/$defs/consumerTopologyOverrides"},
        "canary_consumer": {"$ref": "#/$defs/consumerTopologyOverrides"}
      }
    },
    "topologyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valid_until", "from_overrides"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 100
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "from_overrides": {"$ref": "#/$defs/topologyOverrides"}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "runtime",
        "transport",
        "consumer",
        "canary",
        "topology",
        "slo",
        "watchdog"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 100
        },
        "enabled": {"type": "boolean"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database_url_env",
            "nats_url_env",
            "watchdog_state_path_env"
          ],
          "properties": {
            "database_url_env": {"$ref": "#/$defs/envName"},
            "nats_url_env": {"$ref": "#/$defs/envName"},
            "watchdog_state_path_env": {"$ref": "#/$defs/envName"}
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stream", "subject_prefix"],
          "properties": {
            "stream": {"$ref": "#/$defs/name"},
            "subject_prefix": {"$ref": "#/$defs/name"}
          }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durable",
            "inbox_consumer_name",
            "malformed_lookback_seconds"
          ],
          "properties": {
            "durable": {"$ref": "#/$defs/name"},
            "inbox_consumer_name": {"$ref": "#/$defs/name"},
            "malformed_lookback_seconds": {"$ref": "#/$defs/positiveInteger"},
            "projection_gap_monitor": {"enum": ["inventory_position", "none"]},
            "handler_module": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"},
            "handler_class": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durable",
            "consumer_name",
            "cadence_seconds",
            "timeout_seconds"
          ],
          "properties": {
            "durable": {"$ref": "#/$defs/name"},
            "consumer_name": {"$ref": "#/$defs/name"},
            "cadence_seconds": {"$ref": "#/$defs/positiveNumber"},
            "timeout_seconds": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "topology": {"$ref": "#/$defs/topology"},
        "topology_migration": {"$ref": "#/$defs/topologyMigration"},
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability_target",
            "latency_target_ratio",
            "latency_target_seconds",
            "stale_after_seconds",
            "warning_consecutive_failures",
            "critical_consecutive_failures",
            "warning_slow_burn_rate",
            "critical_fast_burn_rate"
          ],
          "properties": {
            "availability_target": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "latency_target_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "latency_target_seconds": {"$ref": "#/$defs/positiveNumber"},
            "stale_after_seconds": {"$ref": "#/$defs/positiveNumber"},
            "warning_consecutive_failures": {"$ref": "#/$defs/positiveInteger"},
            "critical_consecutive_failures": {"$ref": "#/$defs/positiveInteger"},
            "warning_slow_burn_rate": {"$ref": "#/$defs/positiveNumber"},
            "critical_fast_burn_rate": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_grace_seconds",
            "warning_missing_executions",
            "critical_missing_executions",
            "warning_scheduler_lag_seconds",
            "critical_scheduler_lag_seconds",
            "execution_timeout_seconds"
          ],
          "properties": {
            "start_grace_seconds": {"$ref": "#/$defs/nonnegativeNumber"},
            "warning_missing_executions": {"$ref": "#/$defs/positiveInteger"},
            "critical_missing_executions": {"$ref": "#/$defs/positiveInteger"},
            "warning_scheduler_lag_seconds": {"$ref": "#/$defs/nonnegativeNumber"},
            "critical_scheduler_lag_seconds": {"$ref": "#/$defs/nonnegativeNumber"},
            "execution_timeout_seconds": {"$ref": "#/$defs/positiveNumber"}
          }
        }
      }
    }
  }
}
