{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schema/architecture-coverage.schema.json",
  "title": "Spotwo architecture reference coverage backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "policy", "coverage"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date"},
    "policy": {"$ref": "#/$defs/policy"},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverageItem"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "states", "rules"],
      "properties": {
        "purpose": {"type": "string", "minLength": 30},
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["covered", "partial", "missing"],
          "properties": {
            "covered": {"type": "string", "minLength": 20},
            "partial": {"type": "string", "minLength": 20},
            "missing": {"type": "string", "minLength": 20}
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown_beats_guess",
            "evidence_and_targets_are_separate",
            "commercial_product_presence_is_not_architecture_evidence",
            "standards_do_not_define_internal_domain_ownership",
            "executable_evidence_is_required_before_promoting_candidate_runtime_contracts"
          ],
          "properties": {
            "unknown_beats_guess": {"const": true},
            "evidence_and_targets_are_separate": {"const": true},
            "commercial_product_presence_is_not_architecture_evidence": {"const": true},
            "standards_do_not_define_internal_domain_ownership": {"const": true},
            "executable_evidence_is_required_before_promoting_candidate_runtime_contracts": {"const": true}
          }
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_ref", "priority", "overall", "rationale", "lenses"],
      "properties": {
        "boundary_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "overall": {"type": "string", "enum": ["covered", "partial", "missing"]},
        "rationale": {"type": "string", "minLength": 40},
        "lenses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standards", "open_source", "commercial", "executable"],
          "properties": {
            "standards": {"$ref": "#/$defs/lens"},
            "open_source": {"$ref": "#/$defs/lens"},
            "commercial": {"$ref": "#/$defs/lens"},
            "executable": {"$ref": "#/$defs/lens"}
          }
        }
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "status", "evidence_refs", "research_targets", "gaps"],
      "properties": {
        "requirement": {"type": "string", "enum": ["required", "useful", "not-required"]},
        "status": {"type": "string", "enum": ["covered", "partial", "missing", "not-required"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "research_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 10}
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["standard", "open-source-project", "competitor-product", "repository"]
        },
        "ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
