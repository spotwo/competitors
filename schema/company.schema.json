{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schemas/company.schema.json",
  "title": "Competitor Company",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "entity_type", "website", "markets", "solution_layers", "industries", "products", "status", "last_verified", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "entity_type": {"enum": ["vendor", "platform-vendor", "automation-vendor", "erp-vendor", "open-source-project", "adjacent"]},
    "parent_company_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "former_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "website": {"type": "string", "format": "uri"},
    "hq_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "served_countries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "uniqueItems": true},
    "local_presence_countries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}, "uniqueItems": true},
    "markets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "segments": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "warehouse_complexity": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 5}, "uniqueItems": true},
    "solution_layers": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "deployment_models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "industries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "operating_environments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "categories"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "former_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "segments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "deployment_models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "status": {"enum": ["active", "rebranded", "legacy", "discontinued", "unknown"]},
          "notes": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["active", "acquired", "rebranded", "legacy", "unknown"]},
    "research_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "string"},
    "last_verified": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}
