{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schemas/scenario-registry.schema.json",
  "title": "Golden Warehouse Scenario Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "description", "scenarios", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["adopted", "candidate", "observed", "needs-research"]},
    "description": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "purpose", "steps", "checkpoints", "invariants", "executable_test"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "action": {"type": "string", "minLength": 1},
                "domain_result": {"type": "string"}
              }
            }
          },
          "checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["after", "expect"],
              "properties": {
                "after": {"type": "string", "minLength": 1},
                "expect": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "executable_test": {"type": "string", "pattern": "^tests/test_golden_scenarios\\.py::test_[a-z0-9_]+$"}
        }
      }
    },
    "research_gaps": {"type": "array", "items": {"type": "string"}},
    "last_verified": {"type": "string", "format": "date"}
  }
}
