{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotwo.dev/schema/open-source-project.schema.json",
  "title": "Spotwo open-source logistics research catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "categories", "projects"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"}
    }
  },
  "$defs": {
    "yesNoMaybe": {
      "type": "string",
      "enum": ["yes", "no", "maybe"]
    },
    "yesNo": {
      "type": "string",
      "enum": ["yes", "no"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "organization",
        "category",
        "kind",
        "upstream_url",
        "layers",
        "status",
        "spotwo"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": [
            "application",
            "framework",
            "library",
            "platform",
            "reference-implementation",
            "routing-engine",
            "runtime",
            "specification",
            "tool",
            "workflow-engine"
          ]
        },
        "upstream_url": {"type": "string", "format": "uri"},
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived", "watch"]
        },
        "spotwo": {"$ref": "#/$defs/spotwoAssessment"}
      }
    },
    "spotwoAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevance",
        "priority",
        "disposition",
        "use_directly",
        "study_architecture",
        "prototype",
        "rationale",
        "ideas"
      ],
      "properties": {
        "relevance": {"type": "integer", "minimum": 1, "maximum": 5},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "disposition": {
          "type": "string",
          "enum": ["adopt", "prototype", "study", "watch"]
        },
        "use_directly": {"$ref": "#/$defs/yesNoMaybe"},
        "study_architecture": {"$ref": "#/$defs/yesNo"},
        "prototype": {"$ref": "#/$defs/yesNo"},
        "rationale": {"type": "string", "minLength": 10},
        "ideas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
